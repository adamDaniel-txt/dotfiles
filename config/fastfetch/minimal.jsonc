{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": " ›  "
    },
    "modules": [
//	"break",
        {
            "type": "os",
            "key": "os  ",
            "keyColor": "31"  // = color1
        },
        {
            "type": "kernel",
            "key": "ker ",
            "keyColor": "32"
        },
        {
            "type": "cpu",
            "key" : "cpu ",
            "format": "{cores-logical} x {name}",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "key" : "gpu ",
            "format": "{name}",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key" : "ram ",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": "wm  ",
            "keyColor": "36"
        }
    ]
}
