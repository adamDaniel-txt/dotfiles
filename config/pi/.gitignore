# pi agent configuration - ignore auto-generated and sensitive files

# Session history (auto-generated, personal, often large)
agent/sessions/

# Authentication tokens
agent/auth.json

# Project trust decisions
agent/trust.json

# Installed pi packages (managed by pi install/remove)
agent/git/
agent/npm/
agent/packages.json

# Project-local settings overrides
agent/settings.json

# Auto-generated caches (recreated on demand)
agent/mcp-cache.json
agent/models-store.json

# npm artifacts
node_modules/
